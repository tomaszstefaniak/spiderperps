{
  "expo": {
    "name": "SpiderPerps",
    "slug": "spiderperps",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spiderperps",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0E",
    "ios": {
      "bundleIdentifier": "com.spiderperps",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID confirms each copy trade before your phone signs it.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spiderperps",
      "adaptiveIcon": {
        "backgroundColor": "#0A1E45",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Face ID protects the trading key stored on this phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID confirms each copy trade before your phone signs it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
