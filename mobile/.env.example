# Copy-trading server (backend/). The iOS simulator can use localhost; a real phone needs
# your Mac's LAN IP (http://192.168.x.x:8790) or the deployed https URL.
EXPO_PUBLIC_API_URL=http://localhost:8790
# Web app hosting the one-time "approve this phone" page (web/, route /link).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
