# Copy-trading server (hl-service). The iOS simulator can use localhost; a real phone needs
# your Mac's LAN IP (http://192.168.x.x:8787) or the deployed https URL.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Web app hosting the one-time "approve this phone" page (dex-hl /link).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
