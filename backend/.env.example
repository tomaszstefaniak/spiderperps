# EVM main address that owns the HL account
HL_ACCOUNT_ADDRESS=0x...

# API wallet private key (NOT your main wallet's key). Create one at app.hyperliquid.xyz/API
HL_SECRET_KEY=0x...

# true for testnet, false for mainnet
HL_USE_TESTNET=true

HL_TIMEOUT=30

# ---- copy trading (all optional) ----
# COPY_DB_PATH=copytrade.db
# COPY_WATCH_INTERVAL_S=5          # how often followed leaders are polled
# COPY_MIN_MOVE_PCT=5              # ignore leader size changes smaller than this
# COPY_PROPOSAL_TTL_S=900          # unanswered proposals expire after this
# COPY_PUSH_COOLDOWN_S=60          # max one push per follower+leader in this window
# COPY_DISCOVERY_DEEP_N=120        # wallets deep-scored per discovery refresh
# COPY_DISCOVERY_REFRESH_S=43200
# EXPO_ACCESS_TOKEN=               # only if "enhanced push security" is on in your Expo project
