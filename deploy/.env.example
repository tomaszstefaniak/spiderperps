# Copy to .env next to docker-compose.yml.
DOMAIN=spiderperps.example.com
ACME_EMAIL=you@example.com

# Legacy web order ticket only (copy trading works on both networks regardless).
HL_USE_TESTNET=true
# Never put HL_SECRET_KEY on a public server: the legacy ticket would trade that account for anyone.

# Optional, see backend/.env.example for all copy-trading knobs.
# EXPO_ACCESS_TOKEN=
# COPY_WATCH_INTERVAL_S=5
